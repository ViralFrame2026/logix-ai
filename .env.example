# Valores públicos del proyecto Supabase. La publishable key está diseñada para cliente;
# la seguridad depende de RLS. Nunca uses SUPABASE_SERVICE_ROLE_KEY en el frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL canónica por entorno, usada en callbacks de email.
# Desarrollo: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
