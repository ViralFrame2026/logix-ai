# Valores públicos del proyecto Supabase. La publishable key está diseñada para cliente;
# la seguridad depende de RLS. Nunca uses SUPABASE_SERVICE_ROLE_KEY en el frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origen HTTPS canónico del entorno desplegado. En desarrollo puede omitirse:
# la aplicación usa http://localhost:3000 sólo cuando NODE_ENV=development.
NEXT_PUBLIC_SITE_URL=
